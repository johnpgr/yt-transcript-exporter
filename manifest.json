{
  "manifest_version": 3,
  "name": "YouTube Transcript Exporter",
  "version": "1.0.0",
  "description": "Automatically opens and exports YouTube transcripts to clean TXT or Markdown files with optional timestamps.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_end"
    }
  ]
}
